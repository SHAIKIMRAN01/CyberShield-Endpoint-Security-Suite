# Maven build output
target/

# Local SQLite database: it holds user accounts and vault data, so keep it
# out of git. The app keeps it in %LOCALAPPDATA%\CyberShield\Data now; older
# versions kept it in database/, which these lines still keep out of git.
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm

# Scratch folder: planning documents, and unused files moved out of the build
temp/
