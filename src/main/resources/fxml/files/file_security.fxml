<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cybershield.ui.controllers.FileSecurityController"
      stylesheets="@../../css/file_security.css"
      styleClass="file-security"
      spacing="8">

    <padding>
        <Insets top="16" right="20" bottom="10" left="20"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12">

        <Label text="File Security" styleClass="section-title"/>

        <Label text="Encrypt files and folders with your master vault key and hide them."
               styleClass="hint"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Lock Vault" onAction="#lockVault"/>

    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- PICK AND PROTECT -->
        <Tab text="Protect files">

            <VBox spacing="8">

                <padding>
                    <Insets top="8"/>
                </padding>

                <HBox spacing="6" alignment="CENTER_LEFT">

                    <ComboBox fx:id="driveBox" prefWidth="74" onAction="#changeDrive"/>

                    <Button text="Up" onAction="#goUp"/>

                    <TextField fx:id="pathField"
                               promptText="Folder path"
                               onAction="#goToPath"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Go" onAction="#goToPath"/>

                    <Separator orientation="VERTICAL"/>

                    <Button fx:id="addFilesButton" text="Add files…" onAction="#addFiles"/>

                    <Button fx:id="addFolderButton" text="Add folder…" onAction="#addFolder"/>

                </HBox>

                <TableView fx:id="fileTable" VBox.vgrow="ALWAYS" minHeight="140">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>

                    <placeholder>
                        <Label text="This folder is empty."/>
                    </placeholder>

                    <columns>
                        <TableColumn fx:id="selectColumn" minWidth="34" maxWidth="34" prefWidth="34"
                                     sortable="false" resizable="false"/>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="330"/>
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="90"/>
                        <TableColumn fx:id="sizeColumn" text="Size" prefWidth="80"/>
                        <TableColumn fx:id="modifiedColumn" text="Modified" prefWidth="140"/>
                    </columns>

                </TableView>

                <!-- SELECTION TRAY: picks from every folder stack here, newest on top -->
                <VBox styleClass="tray" spacing="6">

                    <HBox spacing="10" alignment="CENTER_LEFT">

                        <Label fx:id="trayTitle" text="Selected (0)" styleClass="tray-title"/>

                        <Label fx:id="traySummary" styleClass="tray-summary"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="clearSelectionButton" text="Clear all" onAction="#clearSelection"/>

                        <Button fx:id="encryptButton"
                                text="Encrypt &amp; Hide…"
                                onAction="#reviewSelection"
                                styleClass="primary-button"/>

                    </HBox>

                    <!-- minHeight -Infinity = never shrink below the preferred height -->
                    <ListView fx:id="trayList" prefHeight="118" minHeight="-Infinity">
                        <placeholder>
                            <Label text="Nothing selected yet."/>
                        </placeholder>
                    </ListView>

                </VBox>

                <!-- REVIEW: shown after scanning, before anything changes -->
                <VBox fx:id="reviewBox" styleClass="review-box" spacing="8" visible="false" managed="false"
                      minHeight="-Infinity">

                    <Label fx:id="reviewLabel" styleClass="review-text" wrapText="true" minHeight="-Infinity"/>

                    <HBox spacing="8">

                        <Button fx:id="confirmButton"
                                text="Encrypt &amp; hide now"
                                onAction="#confirmProtect"
                                styleClass="danger-button"/>

                        <Button text="Cancel" onAction="#cancelReview"/>

                    </HBox>

                </VBox>

            </VBox>

        </Tab>

        <!-- WHAT IS PROTECTED: a tree on the left, the chosen file on the right.
             Files are decrypted into memory only, never onto the disk. -->
        <Tab fx:id="protectedTab" text="Protected items">

            <SplitPane dividerPositions="0.3" styleClass="viewer-split">

                <VBox spacing="8" minWidth="190">

                    <padding>
                        <Insets top="8" right="6"/>
                    </padding>

                    <TreeView fx:id="vaultTree" VBox.vgrow="ALWAYS"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">

                        <Button fx:id="restoreButton" text="Restore" onAction="#restoreSelected"
                                styleClass="primary-button"/>

                        <Button text="Refresh" onAction="#refreshProtectedItems"/>

                    </HBox>

                </VBox>

                <VBox spacing="8" minWidth="320">

                    <padding>
                        <Insets top="8" left="8"/>
                    </padding>

                    <HBox spacing="8" alignment="CENTER_LEFT">

                        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">

                            <Label fx:id="previewTitle" styleClass="preview-title"/>

                            <Label fx:id="previewDetails" styleClass="hint"/>

                        </VBox>

                        <!-- minWidth -Infinity: keep the full label, let the details text shorten instead -->
                        <Button fx:id="fullScreenButton" text="Full screen" onAction="#openFullScreen"
                                minWidth="-Infinity"/>

                        <Button fx:id="exportButton" text="Export a copy…" onAction="#exportCopy"
                                minWidth="-Infinity"/>

                        <Button fx:id="restoreFileButton" text="Restore file" onAction="#restorePreviewedFile"
                                minWidth="-Infinity"/>

                    </HBox>

                    <StackPane fx:id="previewPane" styleClass="preview-pane" minHeight="120" VBox.vgrow="ALWAYS"/>

                    <HBox fx:id="viewerControls" styleClass="viewer-controls" spacing="6" alignment="CENTER"/>

                </VBox>

            </SplitPane>

        </Tab>

    </TabPane>

    <HBox fx:id="progressBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">

        <ProgressBar fx:id="progressBar" prefWidth="240"/>

        <Label fx:id="progressLabel" styleClass="hint" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>

        <Button text="Stop" onAction="#stopJob"/>

    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">

        <Label fx:id="statusLabel" styleClass="status-label" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>

        <Label fx:id="autoLockLabel" styleClass="hint"/>

    </HBox>

</VBox>
