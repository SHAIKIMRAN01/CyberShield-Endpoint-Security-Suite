<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cybershield.ui.controllers.VaultController"
            stylesheets="@../../css/vault.css"
            prefWidth="500"
            prefHeight="350">

    <center>

        <VBox alignment="CENTER"
              spacing="15">

            <padding>
                <Insets top="30"
                        right="40"
                        bottom="30"
                        left="40"/>
            </padding>

            <Label text="CyberShield Endpoint Security"
                   styleClass="title"/>

            <Label text="Create Master Vault Password"
                   styleClass="heading"/>

            <PasswordField
                    fx:id="passwordField"
                    promptText="Master Password"
                    maxWidth="440"/>

            <PasswordField
                    fx:id="confirmPasswordField"
                    promptText="Confirm Password"
                    maxWidth="440"
                    onAction="#createVault"/>

            <Label text="At least 12 characters with upper and lower case letters, a number and a symbol. It cannot be recovered if you forget it."
                   wrapText="true"
                   textAlignment="CENTER"
                   maxWidth="440"/>

            <Button text="Create Vault"
                    onAction="#createVault"/>

            <Label fx:id="statusLabel"/>

        </VBox>

    </center>

</BorderPane>