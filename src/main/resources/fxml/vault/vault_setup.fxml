<?xml version="1.0" encoding="UTF-8"?>

<!-- First use of the vault: choose a master password. Rule of thirds: an explanation in the left third, the form in the other two. -->

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.cybershield.ui.controllers.VaultController"
           stylesheets="@../../css/vault.css"
           styleClass="vault-screen">

    <GridPane styleClass="card,vault-card" maxWidth="800" maxHeight="-Infinity" StackPane.alignment="TOP_CENTER">

        <columnConstraints>
            <ColumnConstraints percentWidth="33.333"/>
            <ColumnConstraints percentWidth="66.667"/>
        </columnConstraints>

        <VBox styleClass="vault-side" spacing="12" GridPane.columnIndex="0">

            <Group>
                <Group scaleX="1.8" scaleY="1.8">
                    <SVGPath styleClass="vault-icon" fillRule="EVEN_ODD"
                             content="M6.5 10 V7.5 A5.5 5.5 0 0 1 17.5 7.5 V10 H19.5 V21.5 H4.5 V10 Z M9 10 H15 V7.5 A3 3 0 0 0 9 7.5 Z"/>
                </Group>
            </Group>

            <Region minHeight="4"/>

            <Label text="Your vault" styleClass="side-title"/>

            <Label text="It encrypts your saved passwords and protected files." styleClass="side-point" wrapText="true"/>
            <Label text="Only you know the master password. Not even CyberShield stores it." styleClass="side-point" wrapText="true"/>
            <Label text="Nobody can reset it, so keep it somewhere safe." styleClass="side-point" wrapText="true"/>

        </VBox>

        <VBox styleClass="vault-form" spacing="8" GridPane.columnIndex="1">

            <Label text="Create your master password" styleClass="screen-title"/>

            <Label fx:id="sharedWarning"
                   text="The items in the old shared vault stay locked in it: only its master password opens them, and this account won't be able to."
                   styleClass="message,warn" wrapText="true" visible="false" managed="false"/>

            <Region minHeight="6"/>

            <Label text="Master password" styleClass="field-label"/>

            <PasswordField fx:id="passwordField" promptText="At least 12 characters"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <ProgressBar fx:id="strengthBar" progress="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="strength-bar"/>
                <Label fx:id="strengthLabel" styleClass="hint" minWidth="70"/>
            </HBox>

            <Label text="Confirm master password" styleClass="field-label"/>

            <PasswordField fx:id="confirmPasswordField" promptText="Type it again"/>

            <Label text="Use at least 12 characters with upper and lower case letters, a number and a symbol."
                   styleClass="hint" wrapText="true"/>

            <Label fx:id="statusLabel" styleClass="message" wrapText="true" visible="false" managed="false"/>

            <Region minHeight="4"/>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <Button fx:id="actionButton" text="Create vault" defaultButton="true" onAction="#createVault"/>
            </HBox>

        </VBox>

    </GridPane>

</StackPane>
