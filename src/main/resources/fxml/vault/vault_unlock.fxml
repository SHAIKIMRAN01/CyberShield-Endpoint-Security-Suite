<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cybershield.ui.controllers.VaultController"
            stylesheets="@../../css/vault.css"
            prefWidth="500"
            prefHeight="300">

    <center>

        <VBox alignment="CENTER"
              spacing="18">

            <padding>
                <Insets top="30"
                        right="40"
                        bottom="30"
                        left="40"/>
            </padding>

            <Label text="CyberShield Endpoint Security"
                   styleClass="title"/>

            <Label text="Unlock Vault"
                   styleClass="heading"/>

            <PasswordField
                    fx:id="passwordField"
                    promptText="Master Password"
                    maxWidth="440"
                    onAction="#unlockVault"/>

            <Button text="Unlock Vault"
                    onAction="#unlockVault"/>

            <Label fx:id="statusLabel"/>

        </VBox>

    </center>

</BorderPane>