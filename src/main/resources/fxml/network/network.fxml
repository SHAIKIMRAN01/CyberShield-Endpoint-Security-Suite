<?xml version="1.0" encoding="UTF-8"?>

<!--
  Network Analyzer. Top to bottom: a heading, a Refresh control with a one-line
  summary, a progress strip shown only while it reads, the connections table (every
  row explained) that fills most of the height, then a short list of recently
  looked-up names. Works without the vault.
-->

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cybershield.ui.controllers.NetworkController"
      styleClass="home,network"
      spacing="16">

    <stylesheets>
        <URL value="@../../css/network.css"/>
    </stylesheets>

    <VBox spacing="4">
        <Label text="Network Analyzer" styleClass="greeting"/>
        <Label text="See which apps are using your network right now and where they are connecting, each one explained. It reads connection details only — no master key, no traffic contents, nothing changed."
               styleClass="subtitle" wrapText="true"/>
    </VBox>

    <!-- REFRESH + SUMMARY -->
    <HBox spacing="14" alignment="CENTER_LEFT">
        <Button fx:id="refreshButton" text="Refresh" styleClass="primary-button" onAction="#refresh"/>
        <Label fx:id="summaryLabel" styleClass="section-heading" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <!-- PROGRESS (only while reading) -->
    <HBox fx:id="progressBox" styleClass="card,progress-strip" spacing="12" alignment="CENTER_LEFT"
          managed="false" visible="false">
        <ProgressBar fx:id="progressBar" progress="-1" prefWidth="220"/>
        <Label fx:id="statusLabel" styleClass="hint" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <!-- CONNECTIONS -->
    <TableView fx:id="connectionsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="appColumn" text="App" prefWidth="150" minWidth="110"/>
            <TableColumn fx:id="scopeColumn" text="Where" prefWidth="120" minWidth="100"/>
            <TableColumn fx:id="serviceColumn" text="Service" prefWidth="170" minWidth="120"/>
            <TableColumn fx:id="addressColumn" text="Address" prefWidth="190" minWidth="140"/>
            <TableColumn fx:id="explanationColumn" text="What it's doing" prefWidth="360" minWidth="200"/>
        </columns>
    </TableView>

    <!-- RECENTLY LOOKED-UP NAMES (DNS cache) -->
    <VBox fx:id="dnsBox" spacing="6" managed="false" visible="false">
        <Label fx:id="dnsHeading" text="Recently looked-up names" styleClass="card-title"/>
        <TableView fx:id="dnsTable" prefHeight="170" minHeight="120">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="360" minWidth="200"/>
                <TableColumn fx:id="resolvedColumn" text="Resolved to" prefWidth="420" minWidth="200"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
