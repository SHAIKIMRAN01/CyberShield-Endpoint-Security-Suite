<?xml version="1.0" encoding="UTF-8"?>

<!-- Settings. Rule of thirds: the list of sections in the left third, the chosen section in the other two. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.cybershield.ui.controllers.SettingsController"
          stylesheets="@../../css/settings.css"
          styleClass="settings"
          hgap="22">

    <columnConstraints>
        <ColumnConstraints percentWidth="33.333"/>
        <ColumnConstraints percentWidth="66.667"/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints vgrow="ALWAYS"/>
    </rowConstraints>

    <!-- SECTIONS -->
    <VBox styleClass="settings-nav" spacing="6" GridPane.columnIndex="0">

        <Button fx:id="securityTab" styleClass="settings-tab" maxWidth="Infinity" maxHeight="-Infinity" onAction="#showSecurity">
            <graphic>
                <VBox spacing="2">
                    <Label text="Auto-lock and clipboard" styleClass="tab-title"/>
                    <Label text="When the vault locks, how long copies last" styleClass="tab-text"/>
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="appearanceTab" styleClass="settings-tab" maxWidth="Infinity" maxHeight="-Infinity" onAction="#showAppearance">
            <graphic>
                <VBox spacing="2">
                    <Label text="Appearance" styleClass="tab-title"/>
                    <Label text="Light or dark" styleClass="tab-text"/>
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="accountTab" styleClass="settings-tab" maxWidth="Infinity" maxHeight="-Infinity" onAction="#showAccount">
            <graphic>
                <VBox spacing="2">
                    <Label text="Account password" styleClass="tab-title"/>
                    <Label text="The password you sign in with" styleClass="tab-text"/>
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="masterTab" styleClass="settings-tab" maxWidth="Infinity" maxHeight="-Infinity" onAction="#showMaster">
            <graphic>
                <VBox spacing="2">
                    <Label text="Master password" styleClass="tab-title"/>
                    <Label text="The password that opens your vault" styleClass="tab-text"/>
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="historyTab" styleClass="settings-tab" maxWidth="Infinity" maxHeight="-Infinity" onAction="#showHistory">
            <graphic>
                <VBox spacing="2">
                    <Label text="Sign-in history" styleClass="tab-title"/>
                    <Label text="Every sign-in to this account" styleClass="tab-text"/>
                </VBox>
            </graphic>
        </Button>

        <Button fx:id="backupTab" styleClass="settings-tab" maxWidth="Infinity" maxHeight="-Infinity" onAction="#showBackup">
            <graphic>
                <VBox spacing="2">
                    <Label text="Backup and restore" styleClass="tab-title"/>
                    <Label text="Your protected files, on another drive" styleClass="tab-text"/>
                </VBox>
            </graphic>
        </Button>

    </VBox>

    <StackPane GridPane.columnIndex="1">

        <!-- AUTO-LOCK AND CLIPBOARD -->
        <VBox fx:id="securityPanel" styleClass="card,settings-panel" spacing="8" maxHeight="-Infinity" StackPane.alignment="TOP_LEFT">

            <Label text="Auto-lock and clipboard" styleClass="section-heading"/>

            <Label text="These apply to this account only." styleClass="hint"/>

            <Region minHeight="6"/>

            <Label text="Lock the vault after this many minutes without mouse or keyboard use" styleClass="field-label" wrapText="true"/>

            <Spinner fx:id="autoLockSpinner" editable="true" min="1" max="60" initialValue="5" prefWidth="120"/>

            <Region minHeight="4"/>

            <Label text="Clear a copied password from the clipboard after this many seconds" styleClass="field-label" wrapText="true"/>

            <Spinner fx:id="clipboardSpinner" editable="true" min="5" max="300" initialValue="30" amountToStepBy="5" prefWidth="120"/>

            <Label fx:id="securityMessage" styleClass="message" wrapText="true" visible="false" managed="false"/>

            <Region minHeight="4"/>

            <Button text="Save" styleClass="primary-button" onAction="#saveSecurity"/>

        </VBox>

        <!-- ACCOUNT PASSWORD -->
        <VBox fx:id="accountPanel" styleClass="card,settings-panel" spacing="8" maxHeight="-Infinity" StackPane.alignment="TOP_LEFT"
              visible="false">

            <Label text="Account password" styleClass="section-heading"/>

            <Label fx:id="accountSummary" styleClass="hint" wrapText="true"/>

            <Region minHeight="6"/>

            <Label text="Current password" styleClass="field-label"/>

            <PasswordField fx:id="currentPasswordField"/>

            <Label text="New password" styleClass="field-label"/>

            <PasswordField fx:id="newPasswordField" promptText="At least 8 characters"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <ProgressBar fx:id="accountStrengthBar" progress="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="strength-bar"/>
                <Label fx:id="accountStrengthLabel" styleClass="hint" minWidth="70"/>
            </HBox>

            <Label text="Confirm new password" styleClass="field-label"/>

            <PasswordField fx:id="confirmPasswordField"/>

            <Label fx:id="accountMessage" styleClass="message" wrapText="true" visible="false" managed="false"/>

            <Region minHeight="4"/>

            <Button fx:id="changePasswordButton" text="Change password" styleClass="primary-button" onAction="#changeAccountPassword"/>

        </VBox>

        <!-- MASTER PASSWORD -->
        <VBox fx:id="masterPanel" styleClass="card,settings-panel" spacing="8" maxHeight="-Infinity" StackPane.alignment="TOP_LEFT"
              visible="false">

            <Label text="Master password" styleClass="section-heading"/>

            <Label fx:id="masterSummary" styleClass="hint" wrapText="true"/>

            <VBox fx:id="masterForm" spacing="8">

                <Region minHeight="6"/>

                <Label text="Current master password" styleClass="field-label"/>

                <PasswordField fx:id="currentMasterField"/>

                <Label text="New master password" styleClass="field-label"/>

                <PasswordField fx:id="newMasterField" promptText="At least 12 characters"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ProgressBar fx:id="masterStrengthBar" progress="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="strength-bar"/>
                    <Label fx:id="masterStrengthLabel" styleClass="hint" minWidth="70"/>
                </HBox>

                <Label text="Confirm new master password" styleClass="field-label"/>

                <PasswordField fx:id="confirmMasterField"/>

                <Label text="Your saved passwords and files stay as they are: only the lock on the vault key changes. Nobody can recover a forgotten master password."
                       styleClass="hint" wrapText="true"/>

                <Label fx:id="masterMessage" styleClass="message" wrapText="true" visible="false" managed="false"/>

                <Region minHeight="4"/>

                <Button fx:id="changeMasterButton" text="Change master password" styleClass="primary-button" onAction="#changeMasterPassword"/>

            </VBox>

        </VBox>

        <!-- SIGN-IN HISTORY: the sign-ins in the top third, what the chosen one did below -->
        <VBox fx:id="historyPanel" styleClass="card,settings-panel" spacing="8" StackPane.alignment="TOP_LEFT" visible="false">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Sign-in history" styleClass="section-heading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#refreshHistory"/>
            </HBox>

            <Label fx:id="historySummary" styleClass="hint" wrapText="true" minHeight="-Infinity"/>

            <TableView fx:id="historyTable" minHeight="110">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="No sign-ins recorded yet."/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="timeColumn" text="Signed in" prefWidth="140"/>
                    <TableColumn fx:id="resultColumn" text="Result" prefWidth="125"/>
                    <TableColumn fx:id="deviceColumn" text="Computer" prefWidth="100"/>
                    <TableColumn fx:id="signedOutColumn" text="Signed out"/>
                </columns>

            </TableView>

            <Label fx:id="activityHeading" text="What this sign-in did" styleClass="field-label"/>

            <TableView fx:id="activityTable" VBox.vgrow="ALWAYS" minHeight="120">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="Nothing was done in this sign-in, or pick one above."/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="activityTimeColumn" text="Time" prefWidth="64"/>
                    <TableColumn fx:id="activityWhatColumn" text="What" prefWidth="215"/>
                    <TableColumn fx:id="activityDetailColumn" text="File, login or note"/>
                </columns>

            </TableView>

            <Label text="Sign-ins and what they did are kept for 30 days, then removed. Names are encrypted with your vault key."
                   styleClass="hint" wrapText="true" minHeight="-Infinity"/>

            <HBox spacing="8" alignment="CENTER_LEFT">

                <Button fx:id="clearHistoryButton" text="Clear history…" onAction="#askToClearHistory"/>

                <HBox fx:id="clearBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                    <PasswordField fx:id="clearMasterField" promptText="Master password" prefWidth="200" onAction="#clearHistory"/>
                    <Button fx:id="confirmClearButton" text="Clear" styleClass="danger-button" onAction="#clearHistory"/>
                    <Button text="Cancel" onAction="#cancelClear"/>
                </HBox>

            </HBox>

            <Label fx:id="clearMessage" styleClass="message" wrapText="true" visible="false" managed="false"/>

        </VBox>

        <!-- APPEARANCE -->
        <VBox fx:id="appearancePanel" styleClass="card,settings-panel" spacing="12" maxHeight="-Infinity" StackPane.alignment="TOP_LEFT" visible="false">

            <fx:define>
                <ToggleGroup fx:id="themeGroup"/>
            </fx:define>

            <Label text="Appearance" styleClass="section-heading"/>

            <Label text="Each account chooses for itself, and it changes at once. The sign-in screen shows the theme the last account used."
                   styleClass="hint" wrapText="true" minHeight="-Infinity"/>

            <HBox spacing="14">

                <RadioButton fx:id="lightChoice" toggleGroup="$themeGroup" styleClass="theme-choice" text="Light">
                    <graphic>
                        <HBox styleClass="theme-swatch,light" spacing="4">
                            <Region styleClass="swatch-side"/>
                            <VBox spacing="5" styleClass="swatch-page">
                                <Region styleClass="swatch-heading"/>
                                <Region styleClass="swatch-line"/>
                                <Region styleClass="swatch-button"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </RadioButton>

                <RadioButton fx:id="darkChoice" toggleGroup="$themeGroup" styleClass="theme-choice" text="Dark">
                    <graphic>
                        <HBox styleClass="theme-swatch,dark" spacing="4">
                            <Region styleClass="swatch-side"/>
                            <VBox spacing="5" styleClass="swatch-page">
                                <Region styleClass="swatch-heading"/>
                                <Region styleClass="swatch-line"/>
                                <Region styleClass="swatch-button"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </RadioButton>

            </HBox>

            <Label fx:id="appearanceMessage" styleClass="message" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>

        </VBox>

        <!-- BACKUP AND RESTORE -->
        <VBox fx:id="backupPanel" styleClass="card,settings-panel" spacing="10" maxHeight="-Infinity" StackPane.alignment="TOP_LEFT" visible="false">

            <Label text="Backup and restore" styleClass="section-heading"/>

            <Label text="A backup copies your protected files, still encrypted, with your vault's key into a new folder on the drive you choose: a USB stick or an external disk is best. Only your master password opens it."
                   styleClass="hint" wrapText="true" minHeight="-Infinity"/>

            <Label fx:id="backupStatus" styleClass="backup-status" wrapText="true" minHeight="-Infinity"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="backUpButton" text="Back up…" styleClass="primary-button" onAction="#backUp" minWidth="-Infinity"/>
                <Button fx:id="restoreButton" text="Restore from a backup…" onAction="#restoreBackup" minWidth="-Infinity"/>
                <Button fx:id="unlockForBackupButton" text="Unlock the vault" styleClass="primary-button" onAction="#unlockForBackup"
                        minWidth="-Infinity" visible="false" managed="false"/>
            </HBox>

            <HBox fx:id="backupProgressBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                <ProgressBar fx:id="backupProgress" progress="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Label fx:id="backupProgressLabel" styleClass="hint" minWidth="-Infinity"/>
                <Button text="Stop" onAction="#stopBackupJob" minWidth="-Infinity"/>
            </HBox>

            <Label fx:id="backupMessage" styleClass="message" wrapText="true" visible="false" managed="false" minHeight="-Infinity"/>

            <Label text="Restoring brings back the files that are no longer listed in File Security; those still listed are left alone. Saved logins and secure notes stay in CyberShield's own database and aren't part of this backup."
                   styleClass="hint" wrapText="true" minHeight="-Infinity"/>

        </VBox>

    </StackPane>

</GridPane>
