<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cybershield.ui.controllers.PasswordVaultController"
      stylesheets="@../../css/password_vault.css"
      styleClass="password-vault"
      spacing="14">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <!-- HEADER (the screen's name is in the window's header bar) -->
    <HBox alignment="CENTER_LEFT" spacing="10">

        <Label text="Saved logins of this account, encrypted with your vault key."
               styleClass="subtitle"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button minWidth="-Infinity" text="Lock Vault"
                onAction="#lockVault"/>

    </HBox>

    <!-- Rule of thirds: the form takes the left third, the saved entries the other two. -->
    <GridPane hgap="22" VBox.vgrow="ALWAYS">

        <columnConstraints>
            <ColumnConstraints percentWidth="33.333"/>
            <ColumnConstraints percentWidth="66.667"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>

        <!-- ENTRY FORM -->
        <VBox spacing="8" styleClass="card,entry-form" GridPane.columnIndex="0" maxHeight="-Infinity" GridPane.valignment="TOP">

            <Label text="Entry" styleClass="section-heading"/>

            <Label text="Website *" styleClass="field-label"/>

            <TextField fx:id="websiteField"
                       promptText="e.g. github.com"/>

            <Label text="Username *" styleClass="field-label"/>

            <HBox spacing="6" alignment="CENTER_LEFT">

                <TextField fx:id="usernameField"
                           promptText="Username or email"
                           HBox.hgrow="ALWAYS"/>

                <Button minWidth="-Infinity" text="Copy"
                        onAction="#copyUsername"/>

            </HBox>

            <Label text="Password *" styleClass="field-label"/>

            <HBox spacing="6" alignment="CENTER_LEFT">

                <!-- Both fields share the same text; Show/Hide swaps which one is visible. -->
                <StackPane HBox.hgrow="ALWAYS">

                    <PasswordField fx:id="passwordField"
                                   promptText="Password"/>

                    <TextField fx:id="visiblePasswordField"
                               promptText="Password"
                               visible="false"/>

                </StackPane>

                <Button minWidth="-Infinity" fx:id="showPasswordButton"
                        text="Show"
                        onAction="#togglePasswordVisibility"/>

                <Button minWidth="-Infinity" text="Copy"
                        onAction="#copyPassword"/>

            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">

                <Button minWidth="-Infinity" text="Generate"
                        onAction="#generatePassword"/>

                <Label fx:id="strengthLabel"
                       text="Strength :"
                       styleClass="strength-label"/>

            </HBox>

            <Label text="Notes" styleClass="field-label"/>

            <TextArea fx:id="notesArea"
                      promptText="Optional"
                      prefRowCount="4"
                      wrapText="true"/>

            <FlowPane hgap="8" vgap="8">

                <Button minWidth="-Infinity" text="Save"
                        onAction="#savePassword"
                        styleClass="primary-button"/>

                <Button minWidth="-Infinity" text="Update"
                        onAction="#updatePassword"/>

                <Button minWidth="-Infinity" text="Delete"
                        onAction="#deletePassword"
                        styleClass="danger-button"/>

                <Button minWidth="-Infinity" text="Clear"
                        onAction="#clearForm"/>

            </FlowPane>

        </VBox>

        <!-- SAVED ENTRIES -->
        <VBox spacing="8" GridPane.columnIndex="1">

            <HBox spacing="6" alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search website or username"
                           HBox.hgrow="ALWAYS"/>

                <Button minWidth="-Infinity" text="Clear"
                        onAction="#clearSearch"/>

                <Button minWidth="-Infinity" text="Refresh"
                        onAction="#refreshTable"/>

            </HBox>

            <TableView fx:id="passwordTable" VBox.vgrow="ALWAYS">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="No saved passwords yet."/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="websiteColumn" text="Website"/>
                    <TableColumn fx:id="usernameColumn" text="Username"/>
                    <TableColumn fx:id="updatedColumn" text="Last updated"/>
                </columns>

            </TableView>

        </VBox>

    </GridPane>

    <Label fx:id="statusLabel"
           styleClass="status-label"/>

</VBox>
